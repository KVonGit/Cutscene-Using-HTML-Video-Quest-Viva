<!--Saved by Quest Viva 6.0.4-->
<asl version="600">
  <include ref="English.aslx" />
  <include ref="Core.aslx" />
  <game name="Cutscene Using HTML Video">
    <gameid>8e971fd3-0638-42e0-a04b-78daabc65098</gameid>
    <version>0.1</version>
    <firstpublished>2026</firstpublished>
    <showtitle type="boolean">false</showtitle>
    <subtitle>An example/test game</subtitle>
    <author>KV</author>
    <cover>cutscene.png</cover>
    <description><![CDATA[Example/test game<br/><br/>CREDITS<br/>\"Funky Boxstep\" Kevin MacLeod (incompetech.com)<br/>Licensed under Creative Commons: By Attribution 4.0 License<br/>http://creativecommons.org/licenses/by/4.0/ <br/><br/>Cutscene video generated by Claude.]]></description>
    <versioncode type="int">261112</versioncode>
    <start type="script">
      do (version_cmd, "script")
      msg ("")
      // VideoWithAudioPrompt
      // This is a silent, .5 second sound, here to make the Begin button appear when the game loads
      play sound ("faker.wav", false, false)
</start>
  </game>
  <object name="room">
    <inherit name="editor_room" />
    <firstenter type="script">
      do (button, "push")
</firstenter>
    <object name="player">
      <inherit name="editor_object" />
      <inherit name="editor_player" />
    </object>
    <object name="button">
      <inherit name="editor_object" />
      <usestandardverblist />
      <displayverbs type="stringlist">
        <value>Push</value>
      </displayverbs>
      <push type="script">
        PlayCutscene
</push>
      <hit type="script">
        do (this, "push")
</hit>
    </object>
  </object>
  <command name="version_cmd">
    <pattern type="string">^(version|info|about)$</pattern>
    <script><![CDATA[
      msg ("<b>" + game.gamename + "</b>")
      if (HasAttribute (game, "author")) {
        msg ("by " + game.author)
      }
      msg ("v" + game.version)
      if (HasInt (game, "versioncode")) {
        msg ("Release " + game.versioncode + "")
      }
      msg ("IFID: " + game.gameid)
      msg ("<br/><i>CREDITS</i><br/>&middot; \"Funky Boxstep\" Kevin MacLeod (incompetech.com)<br/>{=Spaces(2)}Licensed under Creative Commons: By Attribution 4.0 License<br/>{=Spaces(2)}http://creativecommons.org/licenses/by/4.0/ ")
      msg ("&middot; Cutscene video generated by Claude.")
      SuppressTurnscripts
]]></script>
  </command>
  <function name="VideoEnded" parameters="el_id">
    switch (el_id) {
      case ("cutscene") {
        msg ("Your cutscene has ended.")
      }
      default {
        msg ("Your video (id: \"" + el_id + "\") has ended.")
      }
    }
    HideOutputSection (game._cutscene_output_section_)
    game._cutscene_output_section_ = null
</function>
  <function name="PlayCutscene">
    StartTurnOutputSection
    game._cutscene_output_section_ = game.currentturnoutputsection
    JS.playVid (GetFileURL ("cutscene.mp4"), "cutscene")
    EndOutputSection (game._cutscene_output_section_)
</function>
  <function name="VideoWithAudioPrompt">
    // This is simply to make some interaction happen, so the video will autoplay!
    StartTurnOutputSection
    game._temp_output_section_ = game.currentturnoutputsection
    res = Ask ("This game plays video with audio. Is this okay?")
    if (not res) {
      finish
    }
    EndOutputSection (game._temp_output_section_)
    HideOutputSection (game._temp_output_section_)
    game._temp_output_section_ = null
</function>
  <javascript src="cutSceneUsingHTMLVideo.js" />
</asl>